@startuml!theme plainskinparam linetype orthoentity "User" as user {  * id : UUID <<PK>>  --  * email : VARCHAR(255) <<UNIQUE>>  * password_hash : VARCHAR(255)  * first_name : VARCHAR(100)  * last_name : VARCHAR(100)  * phone : VARCHAR(20)  * created_at : TIMESTAMP  * updated_at : TIMESTAMP  * is_active : BOOLEAN}entity "Room" as room {  * id : UUID <<PK>>  --  * name : VARCHAR(100)  * description : TEXT  * user_id : UUID <<FK>>  * created_at : TIMESTAMP}entity "DeviceType" as device_type {  * id : UUID <<PK>>  --  * name : VARCHAR(100) <<UNIQUE>>  * category : VARCHAR(50)  * protocol : VARCHAR(50)  * description : TEXT}entity "Device" as device {  * id : UUID <<PK>>  --  * serial_number : VARCHAR(100) <<UNIQUE>>  * name : VARCHAR(100)  * device_type_id : UUID <<FK>>  * user_id : UUID <<FK>>  * room_id : UUID <<FK>>  * status : VARCHAR(20)  * ip_address : VARCHAR(45)  * mac_address : VARCHAR(17)  * firmware_version : VARCHAR(50)  * registered_at : TIMESTAMP  * last_seen_at : TIMESTAMP}entity "Telemetry" as telemetry {  * id : UUID <<PK>>  --  * device_id : UUID <<FK>>  * metric_type : VARCHAR(50)  * value : DECIMAL(10,2)  * unit : VARCHAR(20)  * timestamp : TIMESTAMP  * metadata : JSONB}entity "Scenario" as scenario {  * id : UUID <<PK>>  --  * user_id : UUID <<FK>>  * name : VARCHAR(100)  * description : TEXT  * is_active : BOOLEAN  * trigger_type : VARCHAR(50)  * trigger_config : JSONB  * created_at : TIMESTAMP  * updated_at : TIMESTAMP}entity "ScenarioDevice" as scenario_device {  * scenario_id : UUID <<FK>>  * device_id : UUID <<FK>>  --  * action : VARCHAR(50)  * action_params : JSONB  * order : INTEGER}entity "Command" as command {  * id : UUID <<PK>>  --  * device_id : UUID <<FK>>  * user_id : UUID <<FK>>  * command_type : VARCHAR(50)  * command_data : JSONB  * status : VARCHAR(20)  * sent_at : TIMESTAMP  * executed_at : TIMESTAMP  * error_message : TEXT}entity "Technician" as technician {  * id : UUID <<PK>>  --  * employee_id : VARCHAR(50) <<UNIQUE>>  * first_name : VARCHAR(100)  * last_name : VARCHAR(100)  * email : VARCHAR(255)  * phone : VARCHAR(20)  * specialization : VARCHAR(100)  * is_active : BOOLEAN}entity "InstallationRequest" as installation_request {  * id : UUID <<PK>>  --  * user_id : UUID <<FK>>  * technician_id : UUID <<FK>>  * device_type_id : UUID <<FK>>  * status : VARCHAR(20)  * address : TEXT  * scheduled_date : DATE  * completed_date : DATE  * notes : TEXT  * created_at : TIMESTAMP}entity "SupportStaff" as support_staff {  * id : UUID <<PK>>  --  * employee_id : VARCHAR(50) <<UNIQUE>>  * first_name : VARCHAR(100)  * last_name : VARCHAR(100)  * email : VARCHAR(255)  * department : VARCHAR(50)  * is_active : BOOLEAN}entity "SupportTicket" as support_ticket {  * id : UUID <<PK>>  --  * user_id : UUID <<FK>>  * support_staff_id : UUID <<FK>>  * subject : VARCHAR(200)  * description : TEXT  * status : VARCHAR(20)  * priority : VARCHAR(20)  * created_at : TIMESTAMP  * updated_at : TIMESTAMP  * resolved_at : TIMESTAMP}' Relationshipsuser ||--o{ room : "has"user ||--o{ device : "owns"user ||--o{ scenario : "creates"user ||--o{ command : "sends"user ||--o{ installation_request : "creates"user ||--o{ support_ticket : "creates"room ||--o{ device : "contains"device_type ||--o{ device : "categorizes"device ||--o{ telemetry : "generates"device ||--o{ command : "receives"device }o--o{ scenario : "participates in" via scenario_devicescenario ||--o{ scenario_device : "includes"device ||--o{ scenario_device : "participates"technician ||--o{ installation_request : "performs"device_type ||--o{ installation_request : "requested for"support_staff ||--o{ support_ticket : "handles"@enduml