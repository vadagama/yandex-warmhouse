@startuml!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.pumlContainer_Boundary(heatingService, "Heating Control Service") {    Component(commandService, "Command Service", "Go", "Отправка команд на устройства отопления")            Component(commandHandler, "CommandHandler", "Go struct", "Обработчик команд управления")        Component(mqttClient, "MQTTClient", "Go struct", "Клиент для отправки команд по MQTT")        Component(messagePublisher, "MessagePublisher", "Go interface", "Публикация событий в брокер")        Component(deviceRegistry, "DeviceRegistry", "Go interface", "Реестр устройств")}System_Ext(messageBroker, "Message Broker", "RabbitMQ")System_Ext(devices, "Модули управления отоплением", "MQTT устройства")Rel(commandService, commandHandler, "Использует")Rel(commandHandler, mqttClient, "Использует")Rel(commandHandler, messagePublisher, "Использует")Rel(commandHandler, deviceRegistry, "Использует")Rel(messagePublisher, messageBroker, "Публикует события", "AMQP")Rel(mqttClient, devices, "Отправляет команды", "MQTT")note right of commandHandler  Структура CommandHandler:  - ExecuteCommand(command Command) error  - ValidateCommand(command Command) bool  - GetDeviceStatus(deviceID string) Statusend notenote right of mqttClient  Структура MQTTClient:  - Publish(topic string, payload []byte) error  - Subscribe(topic string, handler Handler) error  - Connect() errorend note@enduml